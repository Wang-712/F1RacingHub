# =============================================================
# F1 Racing Hub - 环境变量配置示例
# 复制为 .env 并按需修改；docker compose 会自动加载同目录下的 .env
# =============================================================

# ---- 域名 ----
DOMAIN=F1RacingHub.com
EMAIL=admin@F1RacingHub.com

# ---- 后端（FastAPI） ----
# 上游 F1 数据源（Jolpica，Ergast 社区延续，免费免 key）
F1_API_BASE=https://api.jolpi.ca/ergast/f1
# HTTP 超时（秒）
F1_HTTP_TIMEOUT=20
# 上游请求间隔（秒），避免触发限流
F1_REQUEST_INTERVAL=0.6
# 缓存 TTL（秒）
CACHE_STANDINGS_TTL=600
CACHE_SEASON_TTL=1800
CACHE_CAREER_TTL=86400
CACHE_STATIC_TTL=3600
# 生产环境同源部署，CORS 留空即可
CORS_ORIGINS=
